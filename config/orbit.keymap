#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    quick-tap-ms = <180>;
    tapping-term-ms = <250>;
};

&caps_word {
    continue-list = <UNDERSCORE BACKSPACE DELETE>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

/ {
    trackball_right { cpi = <800>; };

    trackball_listener {
        scroller {
            layers = <3>;
            input-processors = <
                   &zip_xy_to_scroll_mapper
                   &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
                   &zip_scroll_scaler 1 16
            >;

            process-next;
        };
    };

    behaviors {
        td_caps: tap_dance_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&caps_word>, <&kp CAPS>;

            label = "TAP_DANCE_CAPS";
        };

        hmr: homerow_right_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_RIGHT_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 14 13 12 11 10 20 21 22 23 24 30 31>;
        };

        st_shft: sticky_shift {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_SHIFT";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <200>;
            quick-release;
        };

        hml: homerow_left_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LEFT_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 28 18 15 16 17 25 31 26 27 19 29>;
        };

        magic_shift_tap: magic_shift_tap {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk_shift>, <&caps_word>; // 일반 탭 시 Sticky-shift / Shift가 켜져 있으면 Caps-word
            mods = <(MOD_LSFT)>;                    // 감지할 모디파이어 (왼쪽 Shift)
        };

        magic_shift: magic_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;                   // 인자 2개 수신 (<Hold_Key> <Tap_Key>)
            bindings = <&kp>, <&magic_shift_tap>;  // Hold 시 kp 작동 / Tap 시 morph 작동
            flavor = "balanced";                    // 홀드와 탭을 자연스럽게 전환
            tapping-term-ms = <200>;                // 홀드 판정 시간
            quick-tap-ms = <150>;                   // 연타 시 대기시간을 줄여줌
        };

        sk_shift: sk_shift {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <0>;
            bindings = <&kp>;
            release-after-ms = <1000>;              // 1초 동안 다른 입력 없으면 해제
            key-positions = <0>;                    // 다른 키 누르면 즉시 해제
        };

    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            require-prior-idle-ms = <100>;
        };

        combo_grave {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp GRAVE>;
        };

        combo_return {
            timeout-ms = <50>;
            key-positions = <19 29>;
            bindings = <&kp ENTER>;
            slow-release;
            require-prior-idle-ms = <100>;
        };

        combo_lbkt {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp LPAR>;
        };

        combo_rbkt {
            timeout-ms = <50>;
            key-positions = <6 7>;
            bindings = <&kp RPAR>;
        };

        combo_cut {
            timeout-ms = <50>;
            key-positions = <21 11>;
            bindings = <&kp LC(X)>;
        };

        combo_copy {
            timeout-ms = <50>;
            key-positions = <22 12>;
            bindings = <&kp LC(C)>;
        };

        combo_paste {
            timeout-ms = <50>;
            key-positions = <23 13>;
            bindings = <&kp LC(V)>;
        };

        combo_undo {
            bindings = <&kp LC(Z)>;
            key-positions = <20 10>;
            timeout-ms = <50>;
        };

        combo_lclk {
            timeout-ms = <50>;
            key-positions = <17 27>;
            bindings = <&mkp LCLK>;
            slow-release;
            require-prior-idle-ms = <100>;
        };

        combo_rclk {
            bindings = <&mkp RCLK>;
            key-positions = <28 18>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
        };

        combo_mclk {
            bindings = <&mkp MCLK>;
            key-positions = <18 8>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
        };

        combo_prev {
            timeout-ms = <50>;
            key-positions = <16 26>;
            bindings = <&mkp MB4>;
            require-prior-idle-ms = <100>;
        };

        combo_next {
            timeout-ms = <50>;
            key-positions = <25 15>;
            bindings = <&mkp MB5>;
            require-prior-idle-ms = <100>;
        };

        combo_bspc {
            bindings = <&kp BSPC>;
            key-positions = <19 9>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
        };

        combo_tilde {
            bindings = <&kp TILDE>;
            key-positions = <3 4>;
            timeout-ms = <50>;
        };

        combo_under {
            bindings = <&kp UNDER>;
            key-positions = <5 6>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W        &kp E         &kp R         &kp T                &kp Y       &kp U         &kp I         &kp O        &kp P
&hml LWIN A  &hml LALT S  &hml LSHFT D  &hml LCTRL F  &kp G                &kp H       &hmr LCTRL J  &hmr RSHFT K  &hmr LALT L  &hmr RWIN SEMI
&kp Z        &kp X        &kp C         &kp V         &kp B                &kp N       &kp M         &lt 3 COMMA   &lt 3 DOT    &lt 3 SLASH
                                                      &lt 2 SPACE          &magic_shift LSHFT 0
            >;
        };

        number_layer {
            bindings = <
&kp TAB          &kp N7        &kp N8         &kp N9         &kp MINUS          &kp HOME   &kp END          &kp EQUAL      &kp BSPC         &kp DEL
&hml LWIN ASTRK  &hml LALT N4  &hml LSHFT N5  &hml LCTRL N6  &kp PLUS           &kp PG_UP  &hmr LCTRL LEFT  &hmr RSHFT UP  &hmr LALT RIGHT  &hmr RWIN SQT
&kp COMMA        &kp N1        &kp N2         &kp N3         &kp DOT            &kp PG_DN  &kp LBKT         &kp DOWN       &kp RBKT         &kp SLASH
                                                             &kp N0             &trans
            >;
        };

        function_layer {
            bindings = <
&td_caps        &kp BSLH         &kp INS         &kp BSPC         &kp DEL                 &kp C_MUTE    &kp F7  &kp F8  &kp F9  &kp F12
&hml LALT RALT  &trans           &trans          &trans           &msc SCRL_UP            &kp C_VOL_UP  &kp F4  &kp F5  &kp F6  &kp F11
&kp RCTRL       &kp PRINTSCREEN  &msc SCRL_LEFT  &msc SCRL_RIGHT  &msc SCRL_DOWN          &kp C_VOL_DN  &kp F1  &kp F2  &kp F3  &kp F10
                                                                  &trans                  &trans
            >;
        };

        scroll_layer {
            bindings = <
&bootloader  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3          &bt BT_CLR  &bt BT_CLR_ALL  &trans  &trans  &bootloader
&trans       &trans        &trans        &trans        &trans                &trans      &trans          &trans  &trans  &trans
&trans       &trans        &trans        &trans        &trans                &trans      &trans          &trans  &trans  &trans
                                                       &trans                &trans
            >;
        };
    };
};
